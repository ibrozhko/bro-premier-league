# Copy this file to .env.local for local/serverless testing.
# Never commit real secrets.

# football-data.org
FOOTBALL_DATA_API_KEY=your_free_football_data_api_key_here

# Supabase REST API for BPL Predict
PREDICT_SUPABASE_URL=https://your-project.supabase.co
PREDICT_SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here
PREDICT_SESSION_SECRET=your_long_random_session_secret_here
SEASON2_SESSION_SECRET=your_long_random_season2_session_secret_here

# Web Push / PWA cabinet notifications
VITE_WEB_PUSH_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:bpl@broleague.online

# Optional: protect /api/predict-sync-results when called manually.
CRON_SECRET=change_me_for_manual_cron_calls
