{
  "crons": [
    {
      "path": "/api/predict-sync-results",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/season2-scheduled-push",
      "schedule": "0 20 5 8 *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bro-premier-league.vercel.app"
        }
      ],
      "destination": "https://broleague.online/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "bro-premier-league.vercel.app"
        }
      ],
      "destination": "https://broleague.online/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/predict.html"
    },
    {
      "source": "/predict/:path*",
      "destination": "/predict.html"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico|robots.txt|placeholder.svg).*)",
      "destination": "/index.html"
    }
  ]
}
